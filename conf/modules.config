/*
========================================================================================
    Config file for defining DSL2 per module options and publishing paths
========================================================================================
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: 'copy',
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'FASTQC_R1' {
        publishDir = [
            path: { "${params.outdir}/fastqc/R1" },
            mode: 'copy',
            pattern: '*.{html,zip}'
        ]
    }

    withName: 'FASTQC_R2' {
        publishDir = [
            path: { "${params.outdir}/fastqc/R2" },
            mode: 'copy',
            pattern: '*.{html,zip}'
        ]
    }

    withName: 'STAR_INDEX' {
        publishDir = [
            path: { "${params.outdir}/star_index" },
            mode: 'copy'
        ]
    }

    withName: 'STARSOLO_ALIGN' {
        publishDir = [
            path: { "${params.outdir}/starsolo/${meta.id}" },
            mode: 'copy'
        ]
    }

    withName: 'RELABEL_MATRIX' {
        publishDir = [
            path: { "${params.outdir}/counts/per_run" },
            mode: 'copy'
        ]
    }

    withName: 'EXTRACT_READ_COUNT_MATRIX' {
        publishDir = [
            path: { "${params.outdir}/counts/per_run_readcounts" },
            mode: 'copy'
        ]
    }

    withName: 'MERGE_MATRICES' {
        publishDir = [
            path: { "${params.outdir}/counts" },
            mode: 'copy'
        ]
    }

    withName: 'DESEQ2_DIFFERENTIAL' {
        publishDir = [
            path: { "${params.outdir}/differential_expression" },
            mode: 'copy'
        ]
    }

    withName: 'GENE_ENRICHMENT' {
        publishDir = [
            path: { "${params.outdir}/enrichment/${contrast_id}" },
            mode: 'copy'
        ]
    }

    withName: 'MULTIQC' {
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: 'copy'
        ]
    }
}
