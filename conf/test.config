// Use with the brbseq pipeline:  nextflow run main.nf -profile docker -c conf/test_ipa.config --outdir results_ipa
process { resourceLimits = [ cpus: 2, memory: '6.GB', time: '1.h' ] }
params {
    input        = "${projectDir}/assets/test_data_ipa/samplesheet.csv"
    genome_fasta = "${projectDir}/assets/test_data_ipa/reference/genome.fasta"
    gtf          = "${projectDir}/assets/test_data_ipa/reference/genes.gtf"
    solo_cb_start = 1; solo_cb_len = 12; solo_umi_start = 13; solo_umi_len = 16
    sample_meta = "${projectDir}/assets/test_data_ipa/sample_meta.csv"
    contrasts   = "${projectDir}/assets/test_data_ipa/contrasts.csv"
    gmt_file    = "${projectDir}/assets/test_data_ipa/genesets.gmt"
    deseq2_min_count = 5
    enrichment_nperm = 200
}
process { withName: 'STAR_INDEX' { ext.args = '--genomeSAindexNbases 8' } }   // ~590 kb genome
