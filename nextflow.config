/*
========================================================================================
    gauravkp/brbseq Nextflow config file
========================================================================================
*/

params {

    // ---- Input ----
    input         = null   // samplesheet.csv: run,fastq_1,fastq_2,barcode_map
    genome_fasta  = null   // reference FASTA (required if star_index not given)
    gtf           = null   // annotation GTF (required)
    star_index    = null   // path to a PRE-BUILT STAR index dir (optional)

    // ---- Output ----
    outdir        = null
    email         = null
    multiqc_title = null

    // ---- BRB-seq construct geometry (R1 = barcode + UMI) ----
    // Defaults match the published BRB-seq example construct. CHECK THESE against
    // your own oligo design before trusting results - see docs/usage.md.
    solo_cb_start         = 1
    solo_cb_len           = 12
    solo_umi_start        = 13
    solo_umi_len          = 16
    solo_cb_match_wl_type = '1MM'

    // ---- Optional extras ----
    extract_read_counts = false   // also run BRB-seqTools ExtractReadCountMatrix (deprecated upstream tool, off by default)
    brbseqtools_jar_url = 'https://github.com/DeplanckeLab/BRB-seqTools/raw/master/releases/BRBseqTools-1.6.1.jar'
    min_barcode_reads   = 0       // drop low-read barcodes/samples before merging (0 = no filtering)

    // ---- Downstream analysis: differential expression (DESeq2) ----
    // Off unless BOTH are set. See docs/usage.md for the sample_meta/contrasts
    // file formats (assets/sample_meta_example.csv, assets/contrasts_example.csv).
    sample_meta      = null   // CSV/TSV: sample,<covariate columns...>
    contrasts        = null   // CSV/TSV: id,variable,reference,target - one row per comparison
    deseq2_alpha     = 0.05   // padj threshold for the "significant" flag, volcano highlighting
    deseq2_min_count = 10     // drop genes with fewer total counts than this before fitting

    // ---- Downstream analysis: gene-set enrichment (ORA + GSEA) ----
    // Off unless --gmt_file is set (requires sample_meta + contrasts too, since it
    // runs per DESeq2 contrast). GMT format: <set_name>\t<description>\t<gene1>\t...
    // gene IDs must match your GTF's gene_id namespace (e.g. Ensembl IDs or symbols).
    gmt_file                = null
    enrichment_alpha        = 0.05   // padj threshold defining "significant" for ORA
    enrichment_rank_metric  = 'stat' // 'stat' or 'log2FoldChange' - how GSEA ranks genes
    enrichment_min_set_size = 5      // drop gene sets smaller than this after universe overlap
    enrichment_max_set_size = 500    // drop gene sets larger than this
    enrichment_nperm        = 1000   // permutations for the GSEA null distribution
    enrichment_top_n        = 15     // how many top gene sets to show in each plot

    // ---- Conda ----
    conda_env     = null   // path/name of an existing conda env (conda profile only)

    // ---- Config options ----
    config_profile_name        = null
    config_profile_description = null

    // ---- Boilerplate options ----
    publish_dir_mode = 'copy'
    validate_params  = true
    help             = false
    trace_report_suffix = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
    }
    conda {
        conda.enabled          = true
        docker.enabled         = false
        singularity.enabled    = false
        process.conda          = params.conda_env
    }
    docker {
        docker.enabled         = true
        docker.userEmulation   = true
        conda.enabled          = false
        singularity.enabled    = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        conda.enabled          = false
        docker.enabled          = false
    }
    slurm {
        process {
            executor       = 'slurm'
            queue          = 'standard'
            clusterOptions = ''
        }
        executor {
            queueSize = 20
        }
    }
    pbs {
        process {
            executor       = 'pbspro'
            queue          = 'standard'
            clusterOptions = ''
        }
        executor {
            queueSize = 20
        }
    }
    local {
        process.executor = 'local'
    }
    test {
        includeConfig 'conf/test.config'
    }
}

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name            = 'gauravkp/brbseq'
    author          = 'Gaurav Patil'
    homePage        = 'https://github.com/gauravkp1999/brbseq'
    description     = 'BRB-seq (Bulk RNA Barcoding and sequencing) analysis pipeline using STARsolo'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.04.0'
    version         = '1.0.0dev'
    doi             = ''
}
